{
  "_comment": "Template Creatomate — composition vidéo DM Fidelavis (1080×1920, 30s). Importer depuis le dashboard Creatomate (Templates → Import) puis noter le template_id pour l'orchestrateur. Trois variables : restaurant_name (texte), avatar_video_url (mp4 HeyGen), mockup_url (PNG iPhone).",

  "output_format": "mp4",
  "frame_rate": 30,
  "width":  1080,
  "height": 1920,
  "duration": 30,
  "fill_color": "#0A0A0C",

  "elements": [

    {
      "name": "Background_Gradient",
      "type": "shape",
      "track": 1,
      "time": 0, "duration": 30,
      "x": "50%", "y": "50%", "width": "100%", "height": "100%",
      "x_alignment": "50%", "y_alignment": "50%",
      "fill_color": "#0A0A0C",
      "_comment": "Fond noir profond, met en valeur le mockup titane et l'avatar."
    },

    {
      "name": "Subtle_Glow",
      "type": "shape",
      "track": 2,
      "time": 0, "duration": 30,
      "x": "50%", "y": "50%", "width": "120%", "height": "80%",
      "x_alignment": "50%", "y_alignment": "50%",
      "fill_color": "rgba(255,255,255,0.04)",
      "border_radius": "50%",
      "shadow_blur": "120px",
      "_comment": "Halo central doux pour profondeur."
    },

    {
      "name": "Title_intro",
      "type": "text",
      "track": 3,
      "time": 0, "duration": 2.5,
      "x": "50%", "y": "50%",
      "width": "84%", "height": "auto",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Démo personnalisée\\npour {{restaurant_name}}",
      "font_family": "Inter",
      "font_weight": "700",
      "font_size":   "78",
      "line_height": "110%",
      "fill_color":  "#FFFFFF",
      "text_alignment": "center",
      "animations": [
        { "time": 0,   "duration": 0.5, "type": "fade", "easing": "quadratic-out" },
        { "time": 2.0, "duration": 0.5, "type": "fade", "reversed": true, "easing": "quadratic-in" }
      ],
      "_comment": "Titre plein écran les 2 premières secondes, fade in/out."
    },

    {
      "name": "Avatar_left",
      "type": "video",
      "track": 4,
      "time": 2, "duration": 22,
      "x": "20%", "y": "52%",
      "width": "37%", "height": "70%",
      "x_alignment": "50%", "y_alignment": "50%",
      "border_radius": "32px",
      "fit": "cover",
      "source": "{{avatar_video_url}}",
      "audio_track": 1,
      "animations": [
        { "time": 0,    "duration": 0.5,  "type": "fade", "easing": "quadratic-out" },
        { "time": 21.5, "duration": 0.5,  "type": "fade", "reversed": true, "easing": "quadratic-in" }
      ],
      "_comment": "Vidéo HeyGen ~22s, débute à t=2s. Coin gauche, ~37% de la largeur."
    },

    {
      "name": "Mockup_right",
      "type": "image",
      "track": 5,
      "time": 2, "duration": 28,
      "x": "70%", "y": "52%",
      "width": "58%", "height": "88%",
      "x_alignment": "50%", "y_alignment": "50%",
      "fit": "contain",
      "source": "{{mockup_url}}",
      "animations": [
        { "time": 0,    "duration": 0.6, "type": "fade", "easing": "quadratic-out" },
        { "time": 0,    "duration": 0.8, "type": "scale", "scope": "element", "start_scale": "92%", "end_scale": "100%", "easing": "quadratic-out" }
      ],
      "_comment": "Mockup iPhone à droite, visible de t=2 à t=30 (continuité visuelle)."
    },

    {
      "name": "Restaurant_caption",
      "type": "text",
      "track": 6,
      "time": 2.5, "duration": 21.5,
      "x": "20%", "y": "92%",
      "width": "37%",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "{{restaurant_name}}",
      "font_family": "Inter",
      "font_weight": "600",
      "font_size":   "32",
      "line_height": "120%",
      "fill_color":  "#E8E6E2",
      "text_alignment": "center",
      "animations": [
        { "time": 0, "duration": 0.4, "type": "fade" }
      ],
      "_comment": "Petit caption sous l'avatar avec le nom du resto."
    },

    {
      "name": "Steps_text",
      "type": "text",
      "track": 7,
      "time": 24, "duration": 4,
      "x": "50%", "y": "50%",
      "width": "90%", "height": "auto",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Scan  →  Offre activée  →  Client fidélisé",
      "font_family": "Inter",
      "font_weight": "700",
      "font_size":   "62",
      "line_height": "120%",
      "fill_color":  "#FFFFFF",
      "text_alignment": "center",
      "animations": [
        { "time": 0,   "duration": 0.5, "type": "fade", "easing": "quadratic-out" },
        { "time": 3.5, "duration": 0.5, "type": "fade", "reversed": true, "easing": "quadratic-in" }
      ],
      "_comment": "Carte récap (le mockup reste affiché à droite en arrière-plan)."
    },

    {
      "name": "CTA_text",
      "type": "text",
      "track": 8,
      "time": 28, "duration": 2,
      "x": "50%", "y": "50%",
      "width": "84%", "height": "auto",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Votre démonstration est déjà prête.",
      "font_family": "Inter",
      "font_weight": "800",
      "font_size":   "72",
      "line_height": "120%",
      "fill_color":  "#FFFFFF",
      "text_alignment": "center",
      "animations": [
        { "time": 0, "duration": 0.5, "type": "fade", "easing": "quadratic-out" }
      ],
      "_comment": "CTA final 2 dernières secondes."
    },

    {
      "name": "Watermark_Fidelavis",
      "type": "text",
      "track": 9,
      "time": 0, "duration": 30,
      "x": "50%", "y": "97%",
      "width": "80%",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Fidelavis",
      "font_family": "Inter",
      "font_weight": "600",
      "font_size":   "24",
      "letter_spacing": "8%",
      "fill_color":  "rgba(255,255,255,0.55)",
      "text_alignment": "center"
    }

  ]
}
