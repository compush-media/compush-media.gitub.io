{
  "_comment": "Template Creatomate — composition vidéo DM Fidelavis (1080×1920, 30s). Importer depuis le dashboard Creatomate (Templates → Import) puis noter le template_id pour l'orchestrateur. Trois variables : restaurant_name (texte), avatar_video_url (mp4 HeyGen), mockup_url (PNG iPhone).",

  "output_format": "mp4",
  "frame_rate": 30,
  "width":  1080,
  "height": 1920,
  "duration": 30,
  "fill_color": "#0A0A0C",

  "elements": [

    {
      "name": "Background_Gradient",
      "type": "shape",
      "track": 1,
      "time": 0, "duration": 30,
      "x": "50%", "y": "50%", "width": "100%", "height": "100%",
      "x_alignment": "50%", "y_alignment": "50%",
      "fill_color": "#0A0A0C",
      "_comment": "Fond noir profond, met en valeur le mockup titane et l'avatar."
    },

    {
      "name": "Top_title",
      "type": "text",
      "track": 3,
      "time": 0, "duration": 30,
      "x": "50%", "y": "6%",
      "width": "92%", "height": "auto",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Démo personnalisée — {{restaurant_name}}",
      "font_family": "Inter",
      "font_weight": "800",
      "font_size":   "44",
      "line_height": "120%",
      "fill_color":  "#FFFFFF",
      "text_alignment": "center",
      "animations": [
        { "time": 0,    "duration": 0.5, "type": "fade", "easing": "quadratic-out" }
      ],
      "_comment": "Titre permanent en haut (toute la durée)."
    },

    {
      "name": "Avatar_circle",
      "type": "video",
      "track": 4,
      "time": 2, "duration": 22,
      "x": "14%", "y": "18%",
      "width": "200px", "height": "200px",
      "x_alignment": "50%", "y_alignment": "20%",
      "border_radius": "200px",
      "fit": "cover",
      "source": "{{avatar_video_url}}",
      "audio_track": 1,
      "shadow_blur": "24px",
      "shadow_color": "rgba(0,0,0,0.55)",
      "animations": [
        { "time": 0,    "duration": 0.5,  "type": "fade", "easing": "quadratic-out" },
        { "time": 21.5, "duration": 0.5,  "type": "fade", "reversed": true, "easing": "quadratic-in" }
      ],
      "_comment": "Anna en CERCLE (200×200) en HAUT-GAUCHE. y_alignment=20% centre la source sur son visage."
    },

    {
      "name": "Avatar_subtitle",
      "type": "text",
      "track": 5,
      "time": 2, "duration": 22,
      "x": "60%", "y": "18%",
      "width": "62%", "height": "auto",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Découvrez votre wallet\nde fidélité personnalisé",
      "font_family": "Inter",
      "font_weight": "700",
      "font_size":   "42",
      "line_height": "120%",
      "fill_color":  "#E8E6E2",
      "text_alignment": "left",
      "animations": [
        { "time": 0,    "duration": 0.5,  "type": "fade", "easing": "quadratic-out" },
        { "time": 21.5, "duration": 0.5,  "type": "fade", "reversed": true, "easing": "quadratic-in" }
      ],
      "_comment": "Sous-titre à droite d'Anna, mêmes timings."
    },

    {
      "name": "Mockup_right",
      "type": "image",
      "track": 6,
      "time": 2, "duration": 22,
      "x": "50%", "y": "62%",
      "width": "100%", "height": "75%",
      "x_alignment": "50%", "y_alignment": "50%",
      "fit": "contain",
      "source": "{{mockup_url}}",
      "animations": [
        { "time": 0,    "duration": 0.6, "type": "fade", "easing": "quadratic-out" },
        { "time": 0,    "duration": 0.8, "type": "scale", "scope": "element", "start_scale": "96%", "end_scale": "100%", "easing": "quadratic-out" },
        { "time": 21.5, "duration": 0.5, "type": "fade", "reversed": true, "easing": "quadratic-in" }
      ],
      "_comment": "Mockup iPhone dans la moitié basse, taille préservée pour lire le coupon."
    },

    {
      "name": "CTA_text",
      "type": "text",
      "track": 8,
      "time": 24, "duration": 6,
      "x": "50%", "y": "50%",
      "width": "84%", "height": "auto",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Votre démonstration est déjà prête.",
      "font_family": "Inter",
      "font_weight": "800",
      "font_size":   "72",
      "line_height": "120%",
      "fill_color":  "#FFFFFF",
      "text_alignment": "center",
      "animations": [
        { "time": 0, "duration": 0.5, "type": "fade", "easing": "quadratic-out" }
      ],
      "_comment": "CTA final, 6 dernières secondes en fullscreen (les étapes intermédiaires retirées)."
    },

    {
      "name": "Watermark_Fidelavis",
      "type": "text",
      "track": 9,
      "time": 0, "duration": 30,
      "x": "50%", "y": "97%",
      "width": "80%",
      "x_alignment": "50%", "y_alignment": "50%",
      "text": "Fidelavis",
      "font_family": "Inter",
      "font_weight": "600",
      "font_size":   "24",
      "letter_spacing": "8%",
      "fill_color":  "rgba(255,255,255,0.55)",
      "text_alignment": "center"
    }

  ]
}
