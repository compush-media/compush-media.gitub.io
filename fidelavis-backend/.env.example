# ============================================================
#  FIDELAVIS – Variables d'environnement
#  Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# Serveur
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://votre-domaine.com

# JWT
JWT_SECRET=changez-moi-en-une-chaine-aleatoire-tres-longue-64-chars
JWT_EXPIRES_IN=7d

# Base de données
DB_PATH=./data/fidelavis.db

# Google OAuth 2.0
# Créer un projet sur https://console.cloud.google.com
# Activer : Google Business Profile API, My Business Account Management API
# Créer des identifiants OAuth 2.0 (type "Application Web")
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret
GOOGLE_REDIRECT_URI=https://votre-api.com/api/auth/google/callback

# Chiffrement des tokens OAuth en base
# Générer avec : node -e "require('crypto').randomBytes(32).toString('hex')"
ENCRYPTION_KEY=64-hex-chars-aleatoires-ici

# IA – Claude (Anthropic)
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Ou OpenAI (optionnel, si vous préférez GPT)
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=openai   # "anthropic" (défaut) ou "openai"

# Cron – synchronisation automatique des avis
# Format cron : "*/30 * * * *" = toutes les 30 minutes
CRON_SYNC_INTERVAL="*/30 * * * *"

# Sécurité
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logs
LOG_LEVEL=info
LOG_DIR=./logs
